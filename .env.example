# Mainnet RPC used by anvil --fork-url. Get one from Alchemy/Infura/QuickNode.
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/yKAz5XrIiuxswrPW7xiGx7dwcoJVSKLq

# Foundry
FOUNDRY_DISABLE_NIGHTLY_WARNING=1

# Anvil
ANVIL_PORT=8545
ANVIL_CHAIN_ID=31337
ANVIL_BLOCK_TIME=2
ANVIL_HOST=0.0.0.0
# Default anvil deployer (account #0). Funded with 10000 ETH on the fork.
DEPLOYER_PK=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Graph stack (host ports)
POSTGRES_PORT=5432
IPFS_API_PORT=5001
IPFS_GATEWAY_PORT=8080
GRAPH_NODE_HTTP_PORT=8000
GRAPH_NODE_WS_PORT=8001
GRAPH_NODE_ADMIN_PORT=8020
GRAPH_NODE_INDEX_PORT=8030
GRAPH_NODE_METRICS_PORT=8040

# Subgraph
SUBGRAPH_NAME=bank/aml
SUBGRAPH_NETWORK=mainnet

# Backend
BACKEND_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aml_backend?schema=public
SUBGRAPH_URL=http://localhost:8000/subgraphs/name/bank/aml
RPC_URL=http://localhost:8545

# Filled in by scripts/deploy-contracts.sh once contracts exist
REGISTRY_ADDRESS=
STABLECOIN_ADDRESS=
ONRAMP_ADDRESS=
DEPLOY_BLOCK=

# AES passphrase used to encrypt custodial-EOA private keys at rest in the
# backend Postgres. Dev-only: production must use KMS/HSM-backed material.
WALLET_KEY_ENCRYPTION_KEY=dev-only-passphrase-change-in-prod

# ETH amount the backend transfers to a freshly-created custodial EOA so it
# can pay gas when the bank signs token transfers from it. Set to 0 to disable.
WALLET_GAS_TOPUP_ETH=0.1
